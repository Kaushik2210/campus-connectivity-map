# Copy this file to secrets.toml (same folder) and fill in your own values.
# secrets.toml is git-ignored. Never commit or share it.
[mysql]
host = "localhost"
port = 3306
user = "campus"
password = "pick-a-strong-password"
database = "campus_wifi"

# Optional: ask for a PIN before showing the Admin and Database pages.
# [admin]
# pin = "choose-a-pin"

# Optional: where the "Tell IT" button on Check My Spot should write to.
# [contact]
# it_email = "it-helpdesk@your-university.edu"
